{% extends '@Vis/base.html.twig' %}

{% if vis.theme != 'vis' %}
    {% do addAssetComposer(vis.getThemeAssetsPath() ~ '/' ~ vis.theme ~ '/css/theme.min.css') %}
{% else %}
    {% do addAssetComposer('twbs/bootstrap/dist/css/bootstrap.min.css') %}
{% endif %}

{% do addAssetComposer('twbs/bootstrap/dist/js/bootstrap.bundle.min.js') %}
{% do addAssetComposer('fortawesome/font-awesome/css/all.min.css') %}
{% do addAssetComposer(vis.getAssetsPath() ~ '/avalynx-admin/' ~ vis.getAssetsSrcPath() ~ '/css/avalynx-admin.vars.css') %}
{% if userModel is defined and userModel and not app.user %}
    {% do addAssetComposer(vis.getAssetsPath() ~ '/avalynx-admin/' ~ vis.getAssetsSrcPath() ~ '/js/avalynx-admin-guest.js') %}
    {% do addAssetComposer(vis.getAssetsPath() ~ '/avalynx-admin/' ~ vis.getAssetsSrcPath() ~ '/css/avalynx-admin-guest.css') %}
    {% do addAssetComposer(vis.getAssetsPath() ~ '/avalynx-form/' ~ vis.getAssetsSrcPath() ~ '/js/avalynx-form.js') %}
{% else %}
    {% do addAssetComposer(vis.getAssetsPath() ~ '/avalynx-admin/' ~ vis.getAssetsSrcPath() ~ '/js/avalynx-admin.js') %}
    {% do addAssetComposer(vis.getAssetsPath() ~ '/avalynx-admin/' ~ vis.getAssetsSrcPath() ~ '/css/avalynx-admin.css') %}
{% endif %}

{% block javascripts %}
    {{ parent() }}
{% endblock %}

{% block stylesheets %}
    {{ parent() }}
{% endblock %}

{% block body %}
    {% if userModel is defined and userModel and not app.user %}
        {{ include('@Vis/security/_login_modal.html.twig') }}
    {% endif %}
{% endblock %}
