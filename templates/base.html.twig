<!DOCTYPE html>
<html lang="{{ app.request.locale|default('en')|replace({'_':'-'}) }}" data-bs-theme="{{ app.session.get('darkmode', 'light') }}"{% if vis.theme != 'vis' %} data-avalynx-admin-theme="{{ vis.theme }}"{% endif %}>
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>{% block title %}VIS{% endblock %}</title>
        {% block stylesheets %}
            {{ renderAssetComposerStylesheets() }}
        {% endblock %}

        {% block javascripts %}
            <script>
                function AvalynxAdminDarkmodeSave(mode) {
                    fetch('{{ path('vis_api_darkmode', {mode: 'MODE', timestamp: 'TIMESTAMP'}) }}'.replace('MODE', mode).replace('TIMESTAMP', Date.now()));
                }
            </script>
            {{ renderAssetComposerJavascripts() }}
        {% endblock %}
    </head>
    <body id="avalynx-admin-body">
    {% block body %}
    {% endblock %}
    </body>
</html>
