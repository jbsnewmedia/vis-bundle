{% extends '@Vis/base.html.twig' %}

{% if vis.getThemeCss() %}
    {% do addAssetComposer(vis.getThemeCss()) %}
{% else %}
    {% do addAssetComposer('twbs/bootstrap/dist/css/bootstrap.min.css') %}
{% endif %}
{% do addAssetComposer('twbs/bootstrap/dist/js/bootstrap.bundle.min.js') %}
{% do addAssetComposer('fortawesome/font-awesome/css/all.min.css') %}
{% do addAssetComposer('avalynx/avalynx-admin/dist/css/avalynx-admin.vars.css') %}
{% do addAssetComposer('avalynx/avalynx-admin/dist/css/avalynx-admin-guest.vars.css') %}
{% do addAssetComposer('avalynx/avalynx-admin/dist/css/avalynx-admin.css') %}
{% do addAssetComposer('avalynx/avalynx-admin/dist/css/avalynx-admin-guest.css') %}
{% do addAssetComposer('avalynx/avalynx-admin/dist/js/avalynx-admin-guest.js') %}
{% do addAssetComposer('avalynx/avalynx-alert/dist/css/avalynx-alert.css') %}
{% do addAssetComposer('avalynx/avalynx-alert/dist/js/avalynx-alert.js') %}

{% block javascripts %}
    {{ parent() }}
{% endblock %}

{% block stylesheets %}
    {{ parent() }}
{% endblock %}

{% block body %}
    <header id="avalynx-admin-header" class="sticky-top d-flex border-bottom shadow">
        <div class="avalynx-admin-brand d-flex align-items-center justify-content-start" style="padding-left:16px;">
            <img src="{{ getAssetComposerFile('jbsnewmedia/vis-bundle/assets/themes/pina/img/heyPINA_kopf.svg') }}" class="img-fluid avalynx-admin-navigation-logo avalynx-admin-lightmode-flex" style="max-height: 40px; height: auto;" title="heyPINA" alt="heyPINA-logo" onmouseover="this.src='{{ getAssetComposerFile('jbsnewmedia/vis-bundle/assets/themes/pina/img/heyPINA_kopf_zwinker.svg') }}'" onmouseout="this.src='{{ getAssetComposerFile('jbsnewmedia/vis-bundle/assets/themes/pina/img/heyPINA_kopf.svg') }}'">
            <img src="{{ getAssetComposerFile('jbsnewmedia/vis-bundle/assets/themes/pina/img/heyPINA_kopf.svg') }}" class="img-fluid avalynx-admin-navigation-logo avalynx-admin-darkmode-flex d-none" style="max-height: 40px; height: auto;" title="heyPINA" alt="heyPINA-logo" onmouseover="this.src='{{ getAssetComposerFile('jbsnewmedia/vis-bundle/assets/themes/pina/img/heyPINA_kopf_zwinker.svg') }}'" onmouseout="this.src='{{ getAssetComposerFile('jbsnewmedia/vis-bundle/assets/themes/pina/img/heyPINA_kopf.svg') }}'">
            <img src="{{ getAssetComposerFile('jbsnewmedia/vis-bundle/assets/themes/pina/img/heyPINA_logo_braun.svg') }}" class="img-fluid ms-3 avalynx-admin-lightmode-flex d-none d-sm-inline" style="max-height: 40px; height: auto;" title="heyPINA" alt="heyPINA-logo">
            <img src="{{ getAssetComposerFile('jbsnewmedia/vis-bundle/assets/themes/pina/img/heyPINA_logo_weiss.svg') }}" class="img-fluid ms-3 avalynx-admin-darkmode-flex d-none d-sm-inline" style="max-height: 40px; height: auto;" title="heyPINA" alt="heyPINA-logo">
        </div>
        {% for item in vis.getTopbarGuest('start') %}
            {% include item.template with {'item': item} %}
        {% endfor %}
        <div class="flex-grow-1"></div>
        {% for item in vis.getTopbarGuest('end') %}
            {% include item.template with {'item': item} %}
        {% endfor %}
    </header>
    <div id="avalynx-admin-main" class="justify-content-center">
        <div id="avalynx-admin-loader" class="position-absolute w-100 border-top">
            <div class="position-absolute top-50 start-50 translate-middle">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">{{ 'main.loading'|vistrans }}</span>
                </div>
            </div>
        </div>
        {% block content %}
        {% endblock %}
    </div>
{% endblock %}
