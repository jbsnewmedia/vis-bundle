{% extends '@Vis/simple/base.html.twig' %}

{% do addAssetComposer(vis.getAssetsPath() ~ '/avalynx-form/' ~ vis.getAssetsSrcPath() ~ '/js/avalynx-form.js') %}

{% block content %}
    {{ parent() }}
<div class="container-fluid container-xxl col-12 col-sm-10 col-lg-12 col-xl-10 col-xxl-8 pt-5 p-md-5">
    <div class="row rounded border m-0 shadow bg-body text-body">
        <div class="col d-none py-3 d-lg-flex justify-content-center align-items-center">
            {% set mainLogoDefault = vis_logo('main', 'default', null, 'main.logo.default') %}
            {% set mainLogoDefaultHover = vis_logo_hover('main', 'default') %}
            <img src="{{ mainLogoDefault }}" class="img-fluid m-5 avalynx-admin-main-logo avalynx-admin-lightmode-flex" style="max-width: 100%; height: auto;" title="{{ 'main.title.default'|vistrans }}" alt="{{ 'main.title.alt'|vistrans }}"{% if mainLogoDefaultHover %} onmouseover="this.src='{{ mainLogoDefaultHover }}'" onmouseout="this.src='{{ mainLogoDefault }}'"{% endif %}>

            {% set mainLogoDark = vis_logo('main', 'dark', null, 'main.logo.dark') %}
            {% set mainLogoDarkHover = vis_logo_hover('main', 'dark') %}
            <img src="{{ mainLogoDark }}" class="img-fluid m-5 avalynx-admin-main-logo avalynx-admin-darkmode-flex d-none" style="max-width: 100%; height: auto;" title="{{ 'main.title.default'|vistrans }}" alt="{{ 'main.title.alt'|vistrans }}"{% if mainLogoDarkHover %} onmouseover="this.src='{{ mainLogoDarkHover }}'" onmouseout="this.src='{{ mainLogoDark }}'"{% endif %}>
        </div>
        <div class="col">
            <div class="m-2 m-md-5">
                <div class="mt-5 pt-lg-4">
                    <div class="w-100">
                        <h3 class="mb-3">{{ 'login.title'|vistrans }}</h3>
                        {% if error is defined and error %}
                            <div class="alert alert-danger">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
                        {% endif %}
                        {% if app.user %}
                            <p class="mb-3">{{ 'login.loggedin'|vistrans }}</p>
                        {% else %}
                            {% set login_description = 'login.description'|vistrans %}
                            {%  if login_description != '' %}
                                <p class="mb-3">{{ 'login.description'|vistrans }}</p>
                            {% endif %}
                        {% endif %}
                    </div>
                </div>

                {% if app.user %}

                    <div class="mb-4">
                        <label class="form-label" for="_username">{{ 'login.email'|vistrans }}:</label>
                        <div class="form-control">{{ app.user.email }}</div>
                        <span class="invalid-feedback"></span>
                    </div>

                    <a class="btn btn-primary w-100 mb-4" href="{{ path('vis_logout') }}">{{ 'logout.title'|vistrans }}</a>

                {% else %}

                    <form method="post" id="vis-login-form" action="{{ path('vis_login') }}">

                        <div class="mb-4">
                            <label class="form-label" for="_username">{{ 'login.email'|vistrans }}:</label>
                            <input type="text" name="_username" id="_username" class="form-control" value="{{ last_username|default('') }}"/>
                            <span class="invalid-feedback"></span>
                        </div>

                        <div class="mb-4">
                            <label class="form-label" for="_password">{{ 'login.password'|vistrans }}:</label>
                            <input type="password" name="_password" id="_password" class="form-control"/>
                            <span class="invalid-feedback"></span>
                        </div>

                        <button type="submit" class="btn btn-primary w-100 mb-4">{{ 'login.submit'|vistrans }}</button>

                        <div class="mb-3">
                            <div class="form-check">
                                <input type="checkbox" name="_remember_me" id="_remember_me" class="form-check-input" value="1"/>
                                <label class="form-check-label" for="_remember_me">{{ 'login.rememberme'|vistrans }}</label>
                                <span class="invalid-feedback"></span>
                            </div>
                        </div>

                        <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

                    </form>

                {% endif %}

            </div>
        </div>
    </div>
</div>

<script>
    if (document.getElementById('vis-login-form')) { const visForm = new AvalynxForm('vis-login-form'); }
</script>
{% endblock %}
