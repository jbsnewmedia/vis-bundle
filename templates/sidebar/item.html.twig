{% if item.children is not empty %}

    <li class="avalynx-admin-sidenav-item">
        <h2 class="avalynx-admin-sidenav-header">
            <button class="avalynx-admin-sidenav-link{% if item.active %} active{% else %} collapsed{% endif %}" type="button" data-bs-toggle="collapse" data-bs-target="#avalynx-admin-sidenav-{{ item.id }}" aria-expanded="{% if item.active %}true{% else %}false{% endif %}" aria-controls="avalynx-admin-sidenav-{{ item.id }}">
                {% if item.icon != '' %}{{ item.icon|raw }}{% endif %}
                <span class="title">{{ item.label }}</span>
                {{ item.badge|raw }}
                {{ item.counter|raw }}
                <i class="fa-solid fa-chevron-down ms-auto arrow"></i>
            </button>
        </h2>
        <div id="avalynx-admin-sidenav-{{ item.id }}" class="collapse{% if item.active == true %} show{% endif %}">
            <ul class="avalynx-admin-sidenav-sub1">

                    {% for child in item.children %}

                        {% if child.route != '' %}

                        <li class="avalynx-admin-sidenav-item">
                            <h2 class="avalynx-admin-sidenav-header">
                                <a class="avalynx-admin-sidenav-link{% if child.active %} active{% endif %}" href="{{ path(child.route, child.routeparameters is not empty ? child.routeparameters : {}) }}" {% if child.target is defined %} target="{{ child.target }}"{% endif %}>
                                    {% if child.icon != '' %}{{ child.icon|raw }}{% endif %}
                                    <span class="title">{{ child.label }}</span>
                                    {{ child.badge|raw }}
                                    {{ child.counter|raw }}
                                </a>
                            </h2>
                        </li>

                        {% endif %}

                    {% endfor %}

            </ul>
        </div>
    </li>

{% else %}

    <li class="avalynx-admin-sidenav-item">
        <h2 class="avalynx-admin-sidenav-header">
            <a class="avalynx-admin-sidenav-link{% if item.active %} active{% endif %}" href="{{ path(item.route, item.routeparameters is not empty ? item.routeparameters : {}) }}" {% if item.target is defined %} target="{{ item.target }}"{% endif %}>
                {% if item.icon != '' %}{{ item.icon|raw }}{% endif %}
                <span class="title">{{ item.label }}</span>
                {{ item.badge|raw }}
                {{ item.counter|raw }}
            </a>
        </h2>
    </li>

{% endif %}
