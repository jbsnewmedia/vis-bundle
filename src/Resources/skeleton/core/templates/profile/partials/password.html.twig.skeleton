<p class="text-body-secondary">{{ 'profile.password.description'|vistrans }}</p>

<form method="post" id="vis-password-form" action="{{ path('vis_profile_password') }}">
    <div class="mb-3">
        <label class="form-label" for="current_password">{{ 'profile.password.current'|vistrans }}:</label>
        <input type="password" name="current_password" id="current_password" class="form-control" autocomplete="current-password" required/>
        <span class="invalid-feedback"></span>
    </div>

    <div class="mb-3">
        <label class="form-label" for="new_password">{{ 'profile.password.new'|vistrans }}:</label>
        <input type="password" name="new_password" id="new_password" class="form-control" autocomplete="new-password" required minlength="8"/>
        <span class="invalid-feedback"></span>
    </div>

    <div class="mb-3">
        <label class="form-label" for="new_password_repeat">{{ 'profile.password.repeat'|vistrans }}:</label>
        <input type="password" name="new_password_repeat" id="new_password_repeat" class="form-control" autocomplete="new-password" required minlength="8"/>
        <span class="invalid-feedback"></span>
    </div>

    <button type="submit" class="btn btn-primary">
        <i class="fa-solid fa-floppy-disk"></i> {{ 'profile.password.submit'|vistrans }}
    </button>
</form>

<script>
    (() => {
        const init = () => {
            const form = new AvalynxForm('vis-password-form', {
                onSuccess: (response) => {
                    if (typeof AvalynxAlert !== 'undefined' && response.message) {
                        new AvalynxAlert(response.message, 'success', { duration: 5000, position: 'bottom-right' });
                    }
                    document.getElementById('vis-password-form').reset();
                }
            });
        };
        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', init);
        } else {
            init();
        }
    })();
</script>
