{% extends '@Vis/tool/base.html.twig' %}

{% do addAssetComposer('avalynx/avalynx-form/dist/js/avalynx-form.js') %}
{% do addAssetComposer('avalynx/avalynx-alert/dist/js/avalynx-alert.js') %}

{% block title %}{{ 'profile.password.title'|vistrans }}{% endblock %}

{% block vis_container %}
    {{ parent() }}
    <div class="container-fluid container-xxl col-12 col-sm-10 col-lg-8 col-xl-6 pt-4">
        <div class="card shadow">
            <div class="card-header">
                <h5 class="card-title mb-0">{{ 'profile.password.title'|vistrans }}</h5>
            </div>
            <div class="card-body">
                {{ include('profile/partials/password.html.twig') }}
            </div>
        </div>
    </div>
{% endblock %}
