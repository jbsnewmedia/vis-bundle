{% extends '@Vis/tool/base.html.twig' %}

{% block title %}{{ title }}{% endblock %}

{% block vis_container %}
    {{ parent() }}
    <div class="container-fluid container-xxl col-12 col-sm-10 col-lg-8 col-xl-6 pt-4">
        <div class="card shadow">
            <div class="card-header">
                <h5 class="card-title mb-0">{{ title }}</h5>
            </div>
            <div class="card-body">
                {{ include('profile/partials/select.html.twig') }}
            </div>
        </div>
    </div>
{% endblock %}
