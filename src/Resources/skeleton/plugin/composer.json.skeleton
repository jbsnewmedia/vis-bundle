{
    "name": "{$lcCompany}/vis-{$lcName}-plugin",
    "type": "symfony-vis-plugin",
    "description": "VIS {$name} Plugin",
    "autoload": {
        "psr-4": {
            "{$namespaceJson}\\": "src/"
        }
    },
    "extra": {
        "amicron-platform-plugin-class": "{$namespaceJson}\\{$bundleName}",
        "label": "VIS {$name} Plugin",
        "description": "VIS {$name} Plugin"
    }
}
