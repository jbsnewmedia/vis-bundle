{
    "name": "{$lcCompany}/vis-{$lcName}-plugin",
    "type": "symfony-vis-plugin",
    "description": "VIS {$name} Plugin",
    "autoload": {
        "psr-4": {
            "{$namespaceJson}\\": "src/"
        }
    },
    "extra": {
        "vis-plugin-class": "{$namespaceJson}\\{$bundleName}"
    }
}
